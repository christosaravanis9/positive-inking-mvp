# Copy to server/.env and fill in. Never commit the real .env file.

# Required for real model calls. Without this the server runs in
# "model unavailable" mode and every journey degrades to Working Notes
# per V3.0 §16 — this is intentional, visible degradation, not a bug.
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
PORT=8787

# Per-route model-call timeout budgets (ms), overriding the defaults in
# engine/src/modelTimeouts.ts. See docs/timeout-matrix.md for the reasoning
# behind each default -- Association and Blueprint are the heaviest
# structured-output calls and get the largest ceiling; simple extraction
# routes (Provenance, Avoidance, Style Reference) get the smallest.
# MODEL_TIMEOUT_DISCOVERY_MS=16000
# MODEL_TIMEOUT_PROVENANCE_MS=10000
# MODEL_TIMEOUT_ASSOCIATION_MS=30000
# MODEL_TIMEOUT_AVOIDANCE_MS=10000
# MODEL_TIMEOUT_STYLE_REFERENCE_MS=12000
# MODEL_TIMEOUT_BLUEPRINT_MS=30000
